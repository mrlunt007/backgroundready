NEXT_PUBLIC_SITE_URL=https://backgroundready.com
NEXT_PUBLIC_FORMSPREE_FORM_ID=your_form_id

# Keep "kit" on Production until Resend is verified, then switch to "resend"
NEXT_PUBLIC_LEAD_PROVIDER=kit

# Resend (server-only — never expose to the browser)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=contact@backgroundready.com
RESEND_REPLY_TO=contact@backgroundready.com

# HMAC secret for confirm/unsubscribe links (required for newsletter confirm)
LEAD_SIGNING_SECRET=generate-a-long-random-string

# Resend Segments + Topic IDs (from Resend dashboard)
RESEND_SEGMENT_CHECKLIST_ID=
RESEND_SEGMENT_NEWSLETTER_ID=
RESEND_TOPIC_NEWSLETTER_ID=
